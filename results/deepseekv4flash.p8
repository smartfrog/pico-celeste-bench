pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- DeepSeek V4 Flash - Celeste-like cavern cart.
-- Palette: navy cavern, grey-brown rock, pale snow caps, red/pink focus, cyan ice.
-- Movement: 1px/f run accel .6 decel .15; g .21 maxfall 2 jump -2; dash 5 diag .7071; 2 hitstop + 4 dash frames; 6x6 hitbox.
-- Climax: row-11 gap, takeoff edge col 8, landing edge col 13 (4 empty cols), run+jump+horizontal dash onto the tower.
-- Route: high ledge (intro) -> mid ledge -> reversal onto spike-guarded pocket with berry detour -> drop to takeoff -> gap dash -> step+spire climb to goal (right half).
-- Second berry floats above the goal spire and stays avoidable; the demo collects exactly 1.
-- controls: arrows move/aim, o jump, x dash
MAX_RUN=1.0
ACCEL=0.6
DECEL=0.15
GRAV=0.21
MAX_FALL=2.0
JUMP_V=-2.0
DASH_SPEED=5.0
DASH_DIAG=0.7071
HITSTOP=2
DASH_FRAMES=4
HS=6
TILE=8

GRID={
"................",
"................",
"................",
"..s.............",
".####...........",
".####...........",
"................",
".............b..",
"......####.....g",
"....b..........#",
"..^^##........##",
"...######....###",
"...######....###",
"...######....###",
"########^^^^####",
"################",
}

function clamp(v,a,b)
 if v<a then return a
 elseif v>b then return b end
 return v
end

function approach(v,t,s)
 if v>t then return max(v-s,t) end
 return min(v+s,t)
end

function solid_at(col,row)
 if col<0 or col>=16 then return true end
 if row<0 or row>=16 then return false end
 for s in all(solids) do
  if s[1]==col and s[2]==row then return true end
 end
 return false
end

function box_hits(x,y)
 local l=flr(x/TILE)
 local r=flr((x+HS-1)/TILE)
 local t=flr(y/TILE)
 local b=flr((y+HS-1)/TILE)
 if l<0 or r>=16 then return true end
 if t<0 then t=0 end
 if b>15 then b=15 end
 for ty=t,b do
  for tx=l,r do
   if solid_at(tx,ty) then return true end
  end
 end
 return false
end

function move_axis(dx,dy)
 local rem
 if dx~=0 then rem=dx else rem=dy end
 local blocked=false
 while abs(rem)>0.0001 do
  local st=clamp(rem,-1,1)
  local nx=px
  local ny=py
  if dx~=0 then nx=px+st else ny=py+st end
  if box_hits(nx,ny) then
   blocked=true
   break
  end
  px=nx
  py=ny
  rem-=st
 end
 return blocked
end

function aim(dx,dy)
 if dx==0 and dy==0 then return facing,0 end
 return dx,dy
end

function _init()
 solids={}
 spikes={}
 berries={}
 goalx=0
 goaly=0
 spawnx=2*TILE+1
 spawny=3*TILE+2
 for row=0,15 do
  for col=0,15 do
   local c=sub(GRID[row+1],col+1,col+1)
   if c=="#" then
    add(solids,{col,row})
   elseif c=="^" then
    add(spikes,{col,row})
   elseif c=="b" then
    add(berries,{col*TILE+4,row*TILE+4,0})
   elseif c=="g" then
    goalx=col*TILE+4
    goaly=row*TILE+4
   end
  end
 end
 demomode=true
 gifsave=true
 gifdone=false
 win_timer=0
 t=0
 parts={}
 trail={}
 for i=1,14 do
  add(parts,{(i*29+13)%128,(i*47+7)%128,0.2+(i%4)*0.1,i})
 end
 extcmd("set_filename","deepseekv4flash.gif")
 extcmd("rec_frames")
 respawn()
end

function respawn()
 px=spawnx
 py=spawny
 vx=0
 vy=0
 grounded=false
 can_dash=true
 hitstop=0
 dleft=0
 dvx=0
 dvy=0
 facing=1
 dead=false
 won=false
 score=0
 deaths=0
 demo_reset()
end

function demo_reset()
 phase=0
 df=0
 djf=-1
 dair=false
 dland=false
end

function nxt(p)
 phase=p
 df=0
 djf=-1
 dair=false
 dland=false
end

function demo_inputs()
 local l=false
 local r=false
 local u=false
 local d=false
 local j=false
 local ds=false
 if not grounded then dair=true end
 if grounded and dair then dland=true end
 if phase==0 then
  if df>=3 then nxt(1) end
 elseif phase==1 then
  r=true
  if df==10 and grounded and djf<0 then djf=df j=true end
  if dland then nxt(2) end
 elseif phase==2 then
  if djf<0 then
   if px>60 then l=true
   elseif px<58 then r=true
   elseif grounded then djf=df j=true l=true end
  else
   l=true
  end
  if dland then nxt(3) end
 elseif phase==3 then
  r=true
  if dland then nxt(4) end
 elseif phase==4 then
  r=true
  if grounded and not box_hits(px+1,py+1) and djf<0 then
   djf=df j=true
  elseif djf>=0 and df-djf==1 then
   ds=true u=true
  end
  if dland then nxt(5) end
 elseif phase==5 then
  r=true
  if df>=6 then nxt(6) end
 elseif phase==6 then
  r=true
  if df==2 and grounded and djf<0 then djf=df j=true end
  if dland then nxt(7) end
 elseif phase==7 then
  if djf<0 then
   if px<112 then r=true
   elseif grounded then djf=df j=true r=true end
  else
   r=true
  end
  if won then phase=8 end
 end
 df+=1
 return l,r,u,d,j,ds
end

function touch()
 if py>=16*TILE then
  dead=true
  return
 end
 local l=flr(px/TILE)
 local r=flr((px+HS-1)/TILE)
 local t=flr(py/TILE)
 local b=flr((py+HS-1)/TILE)
 for sp in all(spikes) do
  if vy>=0 and sp[1]>=l and sp[1]<=r and sp[2]>=t and sp[2]<=b then
   dead=true
   return
  end
 end
 for i=#berries,1,-1 do
  local be=berries[i]
  if abs(be[1]-(px+3))<6 and abs(be[2]-(py+3))<6 then
   score+=1
   del(berries,be)
  end
 end
 if not won and goalx~=0 and abs(goalx-(px+3))<6 and abs(goaly-(py+3))<6 then
  won=true
 end
end

function _update()
 local l=false
 local r=false
 local u=false
 local d=false
 local j=false
 local dash=false
 if demomode then
  if btn(0) or btn(1) or btn(2) or btn(3) or btnp(4) or btnp(5) then
   demomode=false
   gifsave=false
   respawn()
  else
   l,r,u,d,j,dash=demo_inputs()
  end
 else
  l=btn(0)
  r=btn(1)
  u=btn(2)
  d=btn(3)
  j=btnp(4)
  dash=btnp(5)
 end
 local dx=0
 if l and not r then dx=-1 elseif r and not l then dx=1 end
 local dy=0
 if u and not d then dy=-1 elseif d and not u then dy=1 end

 if dead then
  respawn()
  return
 end

 if won then
  win_timer+=1
  if win_timer==45 and gifsave and not gifdone then
   gifdone=true
   extcmd("video",4,1)
  end
  t+=1
  return
 end

 t+=1
 for p in all(parts) do
  p[2]+=p[3]
  if p[2]>127 then
   p[2]=-2
   p[1]=(p[1]*13+17)%128
  end
 end
 if dleft>0 or hitstop>0 then
  if #trail>6 then del(trail,trail[1]) end
  add(trail,{px+3,py+3})
 else
  trail={}
 end

 if hitstop>0 then
  hitstop-=1
  return
 end

 if dleft>0 then
  move_axis(dvx,0)
  move_axis(0,dvy)
  dleft-=1
  if dleft==0 then
   vx=clamp(dvx,-MAX_RUN,MAX_RUN)
   vy=0
   if dvy>0 then vy=clamp(dvy,0,MAX_FALL) end
  end
  grounded=box_hits(px,py+1)
  if grounded then can_dash=true end
  touch()
  return
 end

 if dash and can_dash then
  local ax,ay=aim(dx,dy)
  dvx=ax*DASH_SPEED
  dvy=ay*DASH_SPEED
  if ax~=0 and ay~=0 then
   dvx*=DASH_DIAG
   dvy*=DASH_DIAG
  end
  can_dash=false
  hitstop=HITSTOP-1
  dleft=DASH_FRAMES
  vx=0
  vy=0
  return
 end

 if dx~=0 then
  facing=dx
  vx=approach(vx,MAX_RUN*dx,ACCEL)
 else
  vx=approach(vx,0,DECEL)
 end
 vy=approach(vy,MAX_FALL,GRAV)
 if j and grounded then vy=JUMP_V end

 if move_axis(vx,0) then vx=0 end
 if move_axis(0,vy) then
  if vy>0 then grounded=true end
  vy=0
 end
 grounded=box_hits(px,py+1)
 if grounded then can_dash=true end

 touch()
end

function draw_bg()
 rectfill(0,0,127,127,1)
 rectfill(0,8,12,26,2)
 rectfill(116,8,127,20,2)
 rectfill(0,56,22,127,2)
 rectfill(34,68,60,127,2)
 rectfill(74,48,104,127,2)
 rectfill(92,70,127,127,2)
 rectfill(0,84,127,127,0)
 rectfill(58,62,84,102,0)
 rectfill(108,50,120,74,0)
 pset(20,20,12)
 pset(46,16,12)
 pset(70,30,12)
 pset(98,20,12)
 pset(116,38,12)
 pset(30,46,13)
 pset(90,42,13)
 pset(8,14,7)
 pset(122,12,7)
end

function _draw()
 cls(1)
 draw_bg()
 for p in all(parts) do
  pset(p[1],p[2],7)
 end
 for s in all(solids) do
  local x=s[1]*TILE
  local y=s[2]*TILE
  local v=6+(s[1]*7+s[2]*3)%4
  if (s[1]*11+s[2]*5)%19==0 then v=11 end
  spr(v,x,y)
 end
 for s in all(solids) do
  local x=s[1]*TILE
  local y=s[2]*TILE
  if not solid_at(s[1]-1,s[2]) then rectfill(x,y,x,y+7,2) end
  if not solid_at(s[1]+1,s[2]) then rectfill(x+7,y,x+7,y+7,2) end
  if not solid_at(s[1],s[2]+1) then rectfill(x,y+7,x+7,y+7,2) end
 end
 for s in all(solids) do
  if not solid_at(s[1],s[2]-1) then
   spr(10,s[1]*TILE,s[2]*TILE)
  end
 end
 for sp in all(spikes) do
  spr(5,sp[1]*TILE,sp[2]*TILE)
 end
 for i=1,#berries do
  local be=berries[i]
  spr(4,be[1]-4,be[2]-4+flr(sin(t/10+i*3)*2))
 end
 if goalx~=0 then
  spr(12,goalx-4,goaly-6)
 end
 print("DeepSeek V4 Flash",31,2,0)
 print("DeepSeek V4 Flash",30,1,7)
 print("x"..score,114,9,8)
 if dleft>0 then
  for i=1,#trail do
   local tr=trail[i]
   rectfill(tr[1]-1,tr[2]-1,tr[1]+1,tr[2]+1,7)
  end
 end
 if not dead then
  local sidx=0
  if facing<0 then sidx=2 end
  if not can_dash then sidx+=1 end
  local bob=0
  if grounded and abs(vx)>0.01 then
   bob=(t%8<4) and -1 or 0
  end
  spr(sidx,px-1,py-1+bob)
 end
 if won then
  print("CLEAR!",53,53,0)
  print("CLEAR!",52,52,7)
  print("DeepSeek V4 Flash",31,65,0)
  print("DeepSeek V4 Flash",30,64,7)
  print("x"..score.." berry",53,77,0)
  print("x"..score.." berry",52,76,8)
 end
end

