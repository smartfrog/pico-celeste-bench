pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- visual: dark navy/black cavern, gray-brown rock, pale snow caps,
--   cyan ice, bright red/pink sprites, green stems, white highlights
-- constants: max run 1, accel 0.6, decel 0.15, grav 0.21,
--   max fall 2, jump -2, dash 5, diag 0.7071, hitstop 2, dash frames 4
-- forced gap row 11 cols 3-6: run right to edge, jump + dash right
-- route: intro left, reversal climb mid, dash-gap climax, goal right
-- demo collects 1 strawberry via detour, reaches goal
-- controls: arrows move, o/x jump/dash, up/down aim dash

