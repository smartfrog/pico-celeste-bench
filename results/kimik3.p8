pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- frosthook cavern (kimi k3): celeste-like per refs: cyan
-- sky, white cavern frame, gray-brown rock, snow caps, ice,
-- navy interior, red/pink focal sprites. run 1 acc .6 dec
-- .15 grav .21 fall 2 jump -2; dash 5 (diag .7071) 2 hitstop
-- +4 move. climax: 4 empty cols row 11 (2-5) run+jump+dash
-- to safe landing cols 6-11; intro hop, reversal, demo berry.
-- grid (. empty # rock ^ spike s spawn b berry g goal):
-- ................
-- ................
-- ................
-- ................
-- ................
-- ................
-- ................
-- ................
-- ................
-- ........b.....g.
-- ............^###
-- ##....##########
-- ###..........###
-- #..s##......b###
-- ######^^^....###
-- ################

-- controls: arrows move/aim dash, z/jump x/dash

max_run=1
accel=0.6
decel=0.15
gravity=0.21
max_fall=2
jump_v=-2
dash_speed=5
dash_diag=0.7071

level={
"................",
"................",
"................",
"................",
"................",
"................",
"................",
"................",
"................",
"........b.....g.",
"............^###",
"##....##########",
"###..........###",
"#..s##......b###",
"######^^^....###",
"################",
}

function tile_at(c,r)
 if r<0 or r>15 or c<0 or c>15 then return "." end
 return sub(level[r+1],c+1,c+1)
end

function solid_at(c,r)
 if c<0 or c>15 then return true end
 if r<0 or r>15 then return false end
 return tile_at(c,r)=="#"
end

function box_solid(x,y)
 local l=flr(x/8)
 local r=flr((x+5)/8)
 if l<0 or r>15 then return true end
 local t=max(0,flr(y/8))
 local b=min(15,flr((y+5)/8))
 for row=t,b do
  for col=l,r do
   if solid_at(col,row) then return true end
  end
 end
 return false
end

function approach(v,t,s)
 if v>t then return max(v-s,t) end
 return min(v+s,t)
end

function move_x(dx)
 local rem=dx
 local blocked=false
 while abs(rem)>0.001 do
  local st=mid(-1,rem,1)
  if box_solid(px+st,py) then
   blocked=true
   break
  end
  px+=st
  rem-=st
 end
 return blocked
end

function move_y(dy)
 local rem=dy
 local blocked=false
 while abs(rem)>0.001 do
  local st=mid(-1,rem,1)
  if box_solid(px,py+st) then
   blocked=true
   break
  end
  py+=st
  rem-=st
 end
 return blocked
end

function touch_entities()
 if py>=128 then
  pdead=true
  deadt=0
  return
 end
 local l=flr(px/8)
 local r=flr((px+5)/8)
 local t=max(0,flr(py/8))
 local b=min(15,flr((py+5)/8))
 for row=t,b do
  for col=l,r do
   local ch=tile_at(col,row)
   if ch=="^" and pvy>=0 then
    pdead=true
    deadt=0
   elseif ch=="g" then
    win=true
    wint=0
   elseif ch=="b" then
    for i=1,#berries do
     local br=berries[i]
     if br.c==col and br.r==row and not br.taken then
      br.taken=true
      score+=1
     end
    end
   end
  end
 end
end

function step_game(inp)
 if pdead or win then return end
 if phitstop>0 then
  phitstop-=1
  return
 end
 if pdash_left>0 then
  move_x(pdash_vx)
  move_y(pdash_vy)
  pdash_left-=1
  if pdash_left==0 then
   pvx=mid(-max_run,pdash_vx,max_run)
   pvy=pdash_vy<=0 and 0 or mid(0,pdash_vy,max_fall)
  end
  pgrounded=box_solid(px,py+1)
  if pgrounded then pcan_dash=true end
  touch_entities()
  return
 end
 if inp.dash and pcan_dash then
  local ddx,ddy=inp.dx,inp.dy
  if ddx==0 and ddy==0 then
   ddx,ddy=pfacing,0
  end
  local vx,vy=ddx*dash_speed,ddy*dash_speed
  if ddx~=0 and ddy~=0 then
   vx,vy=vx*dash_diag,vy*dash_diag
  end
  pdash_vx,pdash_vy=vx,vy
  pcan_dash=false
  phitstop=1
  pdash_left=4
  pvx,pvy=0,0
  return
 end
 if inp.dx~=0 then
  pfacing=inp.dx
  pvx=approach(pvx,max_run*inp.dx,accel)
 else
  pvx=approach(pvx,0,decel)
 end
 pvy=approach(pvy,max_fall,gravity)
 if inp.jump and pgrounded then
  pvy=jump_v
 end
 if move_x(pvx) then pvx=0 end
 if move_y(pvy) then
  if pvy>0 then pgrounded=true end
  pvy=0
 end
 pgrounded=box_solid(px,py+1)
 if pgrounded then pcan_dash=true end
 touch_entities()
end

function respawn()
 pdead=false
 deadt=0
 px=spawn_c*8+1
 py=spawn_r*8+2
 pvx,pvy=0,0
 phitstop=0
 pdash_left=0
 pcan_dash=true
 pfacing=1
 pgrounded=false
end

function adv(p)
 phase=p
 phaset=0
end

function demo_drive()
 phaset+=1
 local inp={dx=0,dy=0,jump=false,dash=false}
 if phase==1 then
  if pgrounded then adv(2) end
 elseif phase==2 then
  inp.dx=1
  if phaset==1 then inp.jump=true end
  if phaset>5 and pgrounded and py<101 then adv(3) end
 elseif phase==3 then
  if pgrounded and abs(pvx)<0.2 then adv(4) end
 elseif phase==4 then
  inp.dx=-1
  if px<=32 then adv(5) end
 elseif phase==5 then
  if pgrounded and abs(pvx)<0.2 then adv(6) end
 elseif phase==6 then
  inp.dx=-1
  if phaset==1 then inp.jump=true end
  if phaset>5 and pgrounded and py<95 then adv(7) end
 elseif phase==7 then
  if pgrounded and abs(pvx)<0.2 then adv(8) end
 elseif phase==8 then
  inp.dx=-1
  if phaset==1 then inp.jump=true end
  if phaset>5 and pgrounded and py<85 then adv(9) end
 elseif phase==9 then
  if pgrounded and abs(pvx)<0.2 then adv(10) end
 elseif phase==10 then
  inp.dx=1
  if px>=14 then adv(11) end
 elseif phase==11 then
  inp.dx=1
  if phaset==1 then inp.jump=true end
  if phaset==10 then inp.dash=true end
  if phaset>15 and pgrounded and px>48 then adv(12) end
 elseif phase==12 then
  if pgrounded and abs(pvx)<0.2 then adv(13) end
 elseif phase==13 then
  inp.dx=1
  if px>=64 then adv(14) end
 elseif phase==14 then
  if pgrounded and abs(pvx)<0.2 then adv(15) end
 elseif phase==15 then
  if phaset==1 then inp.jump=true end
  if phaset>12 and pgrounded then
   if score>=1 then adv(16) else phaset=0 end
  end
 elseif phase==16 then
  if pgrounded and abs(pvx)<0.2 then adv(17) end
 elseif phase==17 then
  inp.dx=1
  if px>=84 then adv(18) end
 elseif phase==18 then
  if pgrounded and abs(pvx)<0.2 then adv(19) end
 elseif phase==19 then
  inp.dx=1
  if phaset==1 then inp.jump=true end
  if phaset>5 and pgrounded and py<80 then adv(20) end
 elseif phase==20 then
  if pgrounded and abs(pvx)<0.2 then adv(21) end
 elseif phase==21 then
  inp.dx=1
 end
 return inp
end

function read_input()
 if demo_active then
  for b=0,5 do
   if btn(b) then
    demo_active=false
    gif_armed=false
    respawn()
    return {dx=0,dy=0,jump=false,dash=false}
   end
  end
  return demo_drive()
 end
 return {
  dx=(btn(1) and 1 or 0)-(btn(0) and 1 or 0),
  dy=(btn(3) and 1 or 0)-(btn(2) and 1 or 0),
  jump=btnp(4),
  dash=btnp(5),
 }
end

function _init()
 extcmd("set_filename","kimik3.gif")
 extcmd("rec_frames")
 berries={}
 for r=0,15 do
  for c=0,15 do
   local ch=tile_at(c,r)
   if ch=="b" then
    add(berries,{c=c,r=r,taken=false})
   elseif ch=="s" then
    spawn_c,spawn_r=c,r
   end
  end
 end
 spawn_c=spawn_c or 3
 spawn_r=spawn_r or 13
 score=0
 deaths=0
 win=false
 wint=0
 pdead=false
 deadt=0
 trail={}
 parts={}
 for i=1,24 do
  add(parts,{
   x=(i*53)%128,
   y=(i*37)%128,
   c=i%4==0 and 7 or 6,
   s=0.1+(i%3)*0.08,
  })
 end
 upds=0
 demo_active=true
 gif_armed=true
 phase=1
 phaset=0
 respawn()
end

function _update()
 upds+=1
 if demo_active and upds>2700 then
  demo_active=false
  gif_armed=false
  respawn()
 end
 if pdead then
  deadt+=1
  if deadt>=12 then
   deaths+=1
   if demo_active then
    demo_active=false
    gif_armed=false
   end
   respawn()
  end
 elseif win then
  wint+=1
  if wint==45 and demo_active and gif_armed then
   extcmd("video",4,1)
  end
 else
  step_game(read_input())
 end
 if pdash_left>0 then
  add(trail,{x=px,y=py})
  if #trail>8 then deli(trail,1) end
 elseif #trail>0 then
  deli(trail,1)
 end
 for p in all(parts) do
  p.y+=p.s
  if p.y>127 then p.y=0 end
 end
end

function is_ice(c,r)
 return (r==13 and c>=4 and c<=5) or (r==11 and c<=1) or (r==10 and c>=13)
end

function draw_sky()
 for c=0,15 do
  local yb=68+((c*29)%3)*3-3
  rectfill(c*8,0,c*8+7,yb,12)
 end
 circfill(24,78,24,1)
 circfill(64,86,30,1)
 circfill(106,74,22,1)
 circfill(24,18,6,7)
 circfill(30,20,5,7)
 circfill(98,12,5,7)
 circfill(104,14,4,7)
 for i=0,12 do
  local x=i*11+(i%2)*3
  if x<36 or x>96 then
   circfill(x,2+(i*7)%3,5,7)
  end
 end
 for i=0,5 do
  circfill(1+(i%2)*2,10+i*10,5,7)
  circfill(126-(i%2)*2,8+i*11,5,7)
 end
end

function draw_terrain()
 for r=0,15 do
  for c=0,15 do
   if solid_at(c,r) then
    local id=5
    if is_ice(c,r) then
     id=solid_at(c,r-1) and 7 or 8
    elseif not solid_at(c,r-1) then
     id=6
    end
    local x,y=c*8,r*8
    spr(id,x,y)
    if not solid_at(c-1,r) then line(x,y,x,y+7,1) end
    if not solid_at(c+1,r) then line(x+7,y,x+7,y+7,1) end
    if not solid_at(c,r+1) then line(x,y+7,x+7,y+7,1) end
   end
  end
 end
 spr(10,16,104)
 spr(10,72,80)
 spr(10,120,72)
 for r=0,15 do
  for c=0,15 do
   local ch=tile_at(c,r)
   if ch=="^" then
    spr(4,c*8,r*8)
   elseif ch=="g" then
    spr(9,c*8,r*8)
   end
  end
 end
 for br in all(berries) do
  if not br.taken then
   spr(3,br.c*8,br.r*8+sin(upds/20+br.c))
  end
 end
end

function _draw()
 cls(1)
 rectfill(0,100,127,127,0)
 draw_sky()
 for p in all(parts) do
  pset(p.x,p.y,p.c)
 end
 draw_terrain()
 for t in all(trail) do
  circfill(t.x+3,t.y+3,1.5,7)
 end
 if not pdead then
  spr(pcan_dash and 1 or 2,px-1,py-1,1,1,pfacing<0)
 end
 print("kimi k3",51,3,1)
 print("kimi k3",50,2,7)
 print(score,111,2,1)
 print(score,110,1,7)
 spr(3,119,0)
 if win then
  print("clear!",49,57,1)
  print("clear!",48,56,7)
 end
end
__gfx__
